{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "prefix": {
      "type": "string",
      "defaultValue": "ezta-dev",
      "minLength": 3,
      "maxLength": 12,
      "metadata": {
        "description": "Lowercase letters, digits and hyphens; use the same prefix in both templates."
      }
    },
    "enableSentinel": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Opt-in paid Sentinel onboarding. Log Analytics ingestion can cost money even when false."
      }
    }
  },
  "variables": {
    "vnet": "[concat(parameters('prefix'), '-vnet')]",
    "nat": "[concat(parameters('prefix'), '-nat')]",
    "pip": "[concat(parameters('prefix'), '-egress-pip')]",
    "connAsg": "[concat(parameters('prefix'), '-conn-asg')]",
    "appAsg": "[concat(parameters('prefix'), '-app-asg')]",
    "connNsg": "[concat(parameters('prefix'), '-conn-nsg')]",
    "appNsg": "[concat(parameters('prefix'), '-app-nsg')]",
    "peNsg": "[concat(parameters('prefix'), '-pe-nsg')]",
    "workspace": "[concat(parameters('prefix'), '-law')]",
    "pe": "[concat(parameters('prefix'), '-kv-pe')]",
    "vault": "[concat('kv-', parameters('prefix'), '-', substring(uniqueString(resourceGroup().id), 0, 8))]",
    "tags": {
      "Environment": "DEV",
      "Project": "EZTA",
      "Data": "Synthetic"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Network/applicationSecurityGroups",
      "apiVersion": "2024-05-01",
      "name": "[variables('connAsg')]",
      "location": "[parameters('location')]",
      "properties": {},
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Network/applicationSecurityGroups",
      "apiVersion": "2024-05-01",
      "name": "[variables('appAsg')]",
      "location": "[parameters('location')]",
      "properties": {},
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2024-05-01",
      "name": "[variables('pip')]",
      "location": "[parameters('location')]",
      "properties": {
        "publicIPAllocationMethod": "Static",
        "publicIPAddressVersion": "IPv4"
      },
      "sku": {
        "name": "Standard"
      },
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Network/natGateways",
      "apiVersion": "2024-05-01",
      "name": "[variables('nat')]",
      "location": "[parameters('location')]",
      "properties": {
        "idleTimeoutInMinutes": 4,
        "publicIpAddresses": [
          {
            "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('pip'))]"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/publicIPAddresses', variables('pip'))]"
      ],
      "sku": {
        "name": "Standard"
      },
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-05-01",
      "name": "[variables('connNsg')]",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": [
          {
            "name": "Allow-Bastion-RDP",
            "properties": {
              "priority": 100,
              "direction": "Inbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "3389",
              "sourceAddressPrefix": "10.42.40.0/26",
              "destinationAddressPrefix": "*"
            }
          },
          {
            "name": "Deny-Other-VNet-Inbound",
            "properties": {
              "priority": 4096,
              "direction": "Inbound",
              "access": "Deny",
              "protocol": "*",
              "sourcePortRange": "*",
              "destinationPortRange": "*",
              "sourceAddressPrefix": "VirtualNetwork",
              "destinationAddressPrefix": "*"
            }
          },
          {
            "name": "Allow-Connector-To-App-HTTPS",
            "properties": {
              "priority": 100,
              "direction": "Outbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "443",
              "sourceApplicationSecurityGroups": [
                {
                  "id": "[resourceId('Microsoft.Network/applicationSecurityGroups', variables('connAsg'))]"
                }
              ],
              "destinationApplicationSecurityGroups": [
                {
                  "id": "[resourceId('Microsoft.Network/applicationSecurityGroups', variables('appAsg'))]"
                }
              ]
            }
          },
          {
            "name": "Allow-Web-Egress-Lab-Exception",
            "properties": {
              "priority": 200,
              "direction": "Outbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRanges": [
                "80",
                "443"
              ],
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "Internet"
            }
          },
          {
            "name": "Allow-Windows-Activation",
            "properties": {
              "priority": 210,
              "direction": "Outbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "1688",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "AzureCloud"
            }
          },
          {
            "name": "Deny-Other-VNet-Outbound",
            "properties": {
              "priority": 4000,
              "direction": "Outbound",
              "access": "Deny",
              "protocol": "*",
              "sourcePortRange": "*",
              "destinationPortRange": "*",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "VirtualNetwork"
            }
          },
          {
            "name": "Deny-Other-Internet-Outbound",
            "properties": {
              "priority": 4090,
              "direction": "Outbound",
              "access": "Deny",
              "protocol": "*",
              "sourcePortRange": "*",
              "destinationPortRange": "*",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "Internet"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/applicationSecurityGroups', variables('connAsg'))]",
        "[resourceId('Microsoft.Network/applicationSecurityGroups', variables('appAsg'))]"
      ],
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-05-01",
      "name": "[variables('appNsg')]",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": [
          {
            "name": "Allow-Connector-HTTPS",
            "properties": {
              "priority": 100,
              "direction": "Inbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "443",
              "sourceApplicationSecurityGroups": [
                {
                  "id": "[resourceId('Microsoft.Network/applicationSecurityGroups', variables('connAsg'))]"
                }
              ],
              "destinationApplicationSecurityGroups": [
                {
                  "id": "[resourceId('Microsoft.Network/applicationSecurityGroups', variables('appAsg'))]"
                }
              ]
            }
          },
          {
            "name": "Allow-Bastion-RDP",
            "properties": {
              "priority": 110,
              "direction": "Inbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "3389",
              "sourceAddressPrefix": "10.42.40.0/26",
              "destinationAddressPrefix": "*"
            }
          },
          {
            "name": "Deny-Other-VNet-Inbound",
            "properties": {
              "priority": 4096,
              "direction": "Inbound",
              "access": "Deny",
              "protocol": "*",
              "sourcePortRange": "*",
              "destinationPortRange": "*",
              "sourceAddressPrefix": "VirtualNetwork",
              "destinationAddressPrefix": "*"
            }
          },
          {
            "name": "Allow-App-To-Private-Endpoint-HTTPS",
            "properties": {
              "priority": 100,
              "direction": "Outbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "443",
              "sourceApplicationSecurityGroups": [
                {
                  "id": "[resourceId('Microsoft.Network/applicationSecurityGroups', variables('appAsg'))]"
                }
              ],
              "destinationAddressPrefix": "10.42.30.0/24"
            }
          },
          {
            "name": "Allow-Web-Egress-Lab-Exception",
            "properties": {
              "priority": 200,
              "direction": "Outbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRanges": [
                "80",
                "443"
              ],
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "Internet"
            }
          },
          {
            "name": "Allow-Windows-Activation",
            "properties": {
              "priority": 210,
              "direction": "Outbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "1688",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "AzureCloud"
            }
          },
          {
            "name": "Deny-Other-VNet-Outbound",
            "properties": {
              "priority": 4000,
              "direction": "Outbound",
              "access": "Deny",
              "protocol": "*",
              "sourcePortRange": "*",
              "destinationPortRange": "*",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "VirtualNetwork"
            }
          },
          {
            "name": "Deny-Other-Internet-Outbound",
            "properties": {
              "priority": 4090,
              "direction": "Outbound",
              "access": "Deny",
              "protocol": "*",
              "sourcePortRange": "*",
              "destinationPortRange": "*",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "Internet"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/applicationSecurityGroups', variables('connAsg'))]",
        "[resourceId('Microsoft.Network/applicationSecurityGroups', variables('appAsg'))]"
      ],
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-05-01",
      "name": "[variables('peNsg')]",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": [
          {
            "name": "Allow-App-To-Vault-HTTPS",
            "properties": {
              "priority": 100,
              "direction": "Inbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "443",
              "sourceApplicationSecurityGroups": [
                {
                  "id": "[resourceId('Microsoft.Network/applicationSecurityGroups', variables('appAsg'))]"
                }
              ],
              "destinationAddressPrefix": "*"
            }
          },
          {
            "name": "Deny-Other-VNet-Inbound",
            "properties": {
              "priority": 4096,
              "direction": "Inbound",
              "access": "Deny",
              "protocol": "*",
              "sourcePortRange": "*",
              "destinationPortRange": "*",
              "sourceAddressPrefix": "VirtualNetwork",
              "destinationAddressPrefix": "*"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/applicationSecurityGroups', variables('connAsg'))]",
        "[resourceId('Microsoft.Network/applicationSecurityGroups', variables('appAsg'))]"
      ],
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2024-05-01",
      "name": "[variables('vnet')]",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.42.0.0/16"
          ]
        },
        "subnets": [
          {
            "name": "snet-connector",
            "properties": {
              "addressPrefix": "10.42.10.0/24",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('connNsg'))]"
              },
              "defaultOutboundAccess": false,
              "privateEndpointNetworkPolicies": "Enabled",
              "natGateway": {
                "id": "[resourceId('Microsoft.Network/natGateways', variables('nat'))]"
              }
            }
          },
          {
            "name": "snet-app",
            "properties": {
              "addressPrefix": "10.42.20.0/24",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('appNsg'))]"
              },
              "defaultOutboundAccess": false,
              "privateEndpointNetworkPolicies": "Enabled",
              "natGateway": {
                "id": "[resourceId('Microsoft.Network/natGateways', variables('nat'))]"
              }
            }
          },
          {
            "name": "snet-private-endpoints",
            "properties": {
              "addressPrefix": "10.42.30.0/24",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('peNsg'))]"
              },
              "defaultOutboundAccess": false,
              "privateEndpointNetworkPolicies": "Enabled"
            }
          },
          {
            "name": "AzureBastionSubnet",
            "properties": {
              "addressPrefix": "10.42.40.0/26"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('connNsg'))]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('appNsg'))]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('peNsg'))]",
        "[resourceId('Microsoft.Network/natGateways', variables('nat'))]"
      ],
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Network/privateDnsZones",
      "apiVersion": "2020-06-01",
      "name": "ezta.internal",
      "location": "global",
      "properties": {},
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2020-06-01",
      "name": "[concat('ezta.internal/', parameters('prefix'), '-link')]",
      "location": "global",
      "properties": {
        "registrationEnabled": false,
        "virtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', variables('vnet'))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', 'ezta.internal')]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnet'))]"
      ]
    },
    {
      "type": "Microsoft.Network/privateDnsZones",
      "apiVersion": "2020-06-01",
      "name": "privatelink.vaultcore.azure.net",
      "location": "global",
      "properties": {},
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2020-06-01",
      "name": "[concat('privatelink.vaultcore.azure.net/', parameters('prefix'), '-link')]",
      "location": "global",
      "properties": {
        "registrationEnabled": false,
        "virtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', variables('vnet'))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', 'privatelink.vaultcore.azure.net')]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnet'))]"
      ]
    },
    {
      "type": "Microsoft.Network/privateDnsZones/A",
      "apiVersion": "2020-06-01",
      "name": "ezta.internal/app",
      "properties": {
        "ttl": 300,
        "aRecords": [
          {
            "ipv4Address": "10.42.20.10"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', 'ezta.internal')]"
      ]
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('workspace')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30,
        "features": {
          "disableLocalAuth": true,
          "enableLogAccessUsingOnlyResourcePermissions": true
        },
        "publicNetworkAccessForIngestion": "Enabled",
        "publicNetworkAccessForQuery": "Enabled"
      },
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[variables('vault')]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "accessPolicies": [],
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7,
        "enablePurgeProtection": true,
        "publicNetworkAccess": "Disabled",
        "networkAcls": {
          "bypass": "None",
          "defaultAction": "Deny",
          "ipRules": [],
          "virtualNetworkRules": []
        }
      },
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2024-05-01",
      "name": "[variables('pe')]",
      "location": "[parameters('location')]",
      "properties": {
        "subnet": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnet'), 'snet-private-endpoints')]"
        },
        "privateLinkServiceConnections": [
          {
            "name": "vault",
            "properties": {
              "privateLinkServiceId": "[resourceId('Microsoft.KeyVault/vaults', variables('vault'))]",
              "groupIds": [
                "vault"
              ]
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnet'))]",
        "[resourceId('Microsoft.KeyVault/vaults', variables('vault'))]"
      ],
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
      "apiVersion": "2024-05-01",
      "name": "[concat(variables('pe'), '/default')]",
      "properties": {
        "privateDnsZoneConfigs": [
          {
            "name": "vault",
            "properties": {
              "privateDnsZoneId": "[resourceId('Microsoft.Network/privateDnsZones', 'privatelink.vaultcore.azure.net')]"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateEndpoints', variables('pe'))]",
        "[resourceId('Microsoft.Network/privateDnsZones', 'privatelink.vaultcore.azure.net')]"
      ]
    },
    {
      "type": "Microsoft.Insights/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "name": "ezta-audit",
      "properties": {
        "workspaceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('workspace'))]",
        "logs": [
          {
            "category": "AuditEvent",
            "enabled": true
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('vault'))]",
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('workspace'))]"
      ],
      "scope": "[resourceId('Microsoft.KeyVault/vaults', variables('vault'))]"
    },
    {
      "type": "Microsoft.SecurityInsights/onboardingStates",
      "apiVersion": "2024-03-01",
      "name": "default",
      "properties": {
        "customerManagedKey": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('workspace'))]"
      ],
      "scope": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('workspace'))]",
      "condition": "[parameters('enableSentinel')]"
    }
  ],
  "outputs": {
    "vnetName": {
      "type": "string",
      "value": "[variables('vnet')]"
    },
    "vaultName": {
      "type": "string",
      "value": "[variables('vault')]"
    },
    "workspaceName": {
      "type": "string",
      "value": "[variables('workspace')]"
    },
    "vaultId": {
      "type": "string",
      "value": "[resourceId('Microsoft.KeyVault/vaults', variables('vault'))]"
    },
    "workspaceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('workspace'))]"
    },
    "appInternalUrl": {
      "type": "string",
      "value": "https://app.ezta.internal/"
    }
  }
}
