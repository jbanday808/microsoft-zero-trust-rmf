// Run each numbered query separately in the intended Log Analytics workspace.
// Missing tables mean source setup or permissions need review; not a passing test.

// 1. Failed interactive sign-ins. Add the actual AppId filter for the pilot rule.
SigninLogs
| where TimeGenerated > ago(15m)
| where ResultType != '0'
// | where AppId == 'REPLACE_WITH_ENTERPRISE_APPLICATION_CLIENT_ID'
| summarize Failures=count(), LastSeen=max(TimeGenerated) by UserPrincipalName, UserId, AppDisplayName, AppId
| where Failures >= 3

// 2. Conditional Access outcomes. Success does not establish every individual control.
SigninLogs
| where TimeGenerated > ago(24h)
| project TimeGenerated, UserPrincipalName, AppDisplayName, ResultType,
          ConditionalAccessStatus, DeviceDetail, ConditionalAccessPolicies, CorrelationId
| order by TimeGenerated desc

// 3. Emergency account use: replace BOTH placeholders with private user object IDs.
// isfuzzy tolerates an unavailable optional table; verify required source health separately.
union isfuzzy=true SigninLogs, AADNonInteractiveUserSignInLogs
| where TimeGenerated > ago(15m)
| where UserId in ('REPLACE_WITH_EMERGENCY_ACCOUNT_1_OBJECT_ID', 'REPLACE_WITH_EMERGENCY_ACCOUNT_2_OBJECT_ID')
| project TimeGenerated, UserId, UserPrincipalName, AppDisplayName, ResultType, IPAddress

// 4. Directory changes. Review the exact operation and target objects.
AuditLogs
| where TimeGenerated > ago(24h)
| project TimeGenerated, OperationName, Result, InitiatedBy, TargetResources, CorrelationId
| order by TimeGenerated desc

// 5. Vault audit events for the template's AzureDiagnostics destination.
AzureDiagnostics
| where TimeGenerated > ago(24h)
| where ResourceProvider =~ 'MICROSOFT.KEYVAULT'
| where Category == 'AuditEvent'
| project TimeGenerated, OperationName, ResultType, ResultSignature, ResourceId
| order by TimeGenerated desc

// 6. Azure management-plane activity, after subscription export is configured.
AzureActivity
| where TimeGenerated > ago(24h)
| where ResourceGroup =~ 'rg-ezta-dev'
| project TimeGenerated, OperationNameValue, ActivityStatusValue, Caller, ResourceId
| order by TimeGenerated desc

// 7. Recent events from configured sources. A missing source is a coverage gap.
union isfuzzy=true withsource=SourceTable SigninLogs, AuditLogs, AzureActivity, AzureDiagnostics
| where TimeGenerated > ago(24h)
| summarize Events=count(), LastEvent=max(TimeGenerated) by SourceTable
